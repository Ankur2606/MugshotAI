# ---- Search backend -------------------------------------------------------
# SerpApi drives Google Lens. Free tier is 250 searches/month.
# Get a key at https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# Optional. FaceCheck.ID is a true face-embedding search and finds social
# profiles far more reliably, but it is paid (credits, crypto only).
# https://facecheck.id/en/Face-Search/API
FACECHECK_API_TOKEN=
FACECHECK_DEMO=false

# Which backend to use: "serpapi" or "facecheck".
# Leave unset to auto-pick the first one that has credentials.
SEARCH_PROVIDER=serpapi

# ---- Chain ----------------------------------------------------------------
# "localhost" uses the Hardhat node (zero setup). "amoy" uses Polygon Amoy.
CHAIN_TARGET=localhost

# Only needed for Amoy. Use a throwaway key funded from a faucet:
# https://faucet.polygon.technology/
DEPLOYER_PRIVATE_KEY=
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
# Set this only if you deployed outside the bundled script.
AMOY_REGISTRY_ADDRESS=
