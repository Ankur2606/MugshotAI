# ---- Search backend -------------------------------------------------------
# SerpApi drives Google Lens. Free tier is 250 searches/month.
# Get a key at https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# Optional. FaceCheck.ID is a true face-embedding search and finds social
# profiles far more reliably, but it is paid (credits, crypto only).
# https://facecheck.id/en/Face-Search/API
FACECHECK_API_TOKEN=
FACECHECK_DEMO=false

# Which backend to use: "serpapi" or "facecheck".
# Leave unset to auto-pick the first one that has credentials.
SEARCH_PROVIDER=serpapi

# ---- Chain Configuration ----------------------------------------------------
# Target chain:
#   - "localhost" : Local Hardhat node. Run `npm run chain:node` and `npm run chain:deploy`.
#                   No private key or testnet tokens required (uses built-in Hardhat account).
#   - "sepolia"   : Ethereum Sepolia Testnet. Requires DEPLOYER_PRIVATE_KEY + SepoliaETH.
#   - "amoy"      : Polygon Amoy Testnet. Requires DEPLOYER_PRIVATE_KEY + Amoy POL.
CHAIN_TARGET=localhost

# Private key of deployer / anchor signer (REQUIRED for Sepolia/Amoy testnets; leave blank for localhost).
# 64-character hex string (with or without '0x' prefix).
# CAUTION: Use a dedicated throwaway development wallet — NEVER use a key with real funds!
DEPLOYER_PRIVATE_KEY=

# ---- Ethereum Sepolia Testnet (Chain ID: 11155111) --------------------------
# Free SepoliaETH faucets:
#   - Google Cloud Web3 Faucet: https://cloud.google.com/application/web3/faucet/ethereum/sepolia
#   - Sepolia PoW Faucet:       https://sepolia-faucet.pk910.de/
#   - Alchemy Sepolia Faucet:   https://www.alchemy.com/faucets/ethereum-sepolia
#   - Chainlink Sepolia Faucet: https://faucets.chain.link/sepolia
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Optional: Set only if using a custom deployment address rather than the automated deploy script
SEPOLIA_REGISTRY_ADDRESS=

# ---- Polygon Amoy Testnet (Chain ID: 80002) ---------------------------------
# Faucet: https://faucet.polygon.technology/
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
# Optional: Set only if using a custom deployment address
AMOY_REGISTRY_ADDRESS=
